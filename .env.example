# Copy to .env (loaded by server/index.ts, and by vite.config.ts for PORT / CROSS_ORIGIN_ISOLATION;
# variables already set in the environment win). .env.local / .env.[mode] only affect VITE_* variables.

# --- Server ---------------------------------------------------------------
# API / production server port (the Vite dev server proxies /api here).
PORT=8787
# Bind address (default: 127.0.0.1 in development, all interfaces with `npm start` / --production /
# NODE_ENV=production). Setting it (e.g. 0.0.0.0) in development exposes the dev API, and a TRIPO_API_KEY, to your network.
# HOST=0.0.0.0
# Production only: directory with the built SPA (default ./dist).
# STATIC_DIR=./dist
# '1' behind exactly one reverse proxy: rate-limit by the last X-Forwarded-For hop ('ip:port' hops are fine).
# TRUST_PROXY=1
# '1' to send COOP + COEP: credentialless so onnxruntime-web can use multi-threaded WASM
# (faster CPU inference for the ML drivers). Also honoured by `vite` / `vite preview`.
# CROSS_ORIGIN_ISOLATION=1

# --- Tripo3D cloud driver --------------------------------------------------
# Server-side key (https://platform.tripo3d.ai). Empty = users enter their own key in the UI.
TRIPO_API_KEY=
# Tripo OpenAPI base URL.
# TRIPO_API_BASE=https://api.tripo3d.ai/v2/openapi
# Comma-separated hosts (and subdomains) model files may be downloaded from.
# TRIPO_ALLOWED_MODEL_HOSTS=tripo3d.ai,tripo3d.com,tripo-data.cdn.bcebos.com
# Task creations per client IP and window: with the server key / with the user's own key (0 = unlimited).
# TRIPO_RATE_LIMIT=10
# TRIPO_RATE_LIMIT_BYOK=60
# TRIPO_RATE_WINDOW_SEC=3600
# Task status polls + model downloads per client IP and minute (each is a Tripo API call; 0 = unlimited).
# TRIPO_READ_RATE_LIMIT=300
# Uploads received at once over all clients (each is buffered in memory; 0 = no cap). Each client IP
# may have at most 3 in progress regardless. Too low lets a few slow uploaders hold up everyone else.
# TRIPO_MAX_CONCURRENT_UPLOADS=16

# --- Browser build (Vite, read at build/dev time) ---------------------------
# Mirror for Hugging Face model files (default https://huggingface.co/).
# VITE_MODEL_HOST=https://huggingface.co/
# Other directory for the onnxruntime-web wasm (default: the copy bundled into /assets). Serve the
# ort-wasm-simd-threaded*.{mjs,wasm} files from node_modules/onnxruntime-web/dist/ there.
# VITE_ORT_WASM_PREFIX=/ort/
# Optional source-code link shown in the top bar.
# VITE_REPO_URL=https://github.com/you/3dmarker
