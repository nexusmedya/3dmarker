# Copy to .env (loaded by server/index.ts, and by vite.config.ts for PORT / CROSS_ORIGIN_ISOLATION;
# variables already set in the environment win). .env.local / .env.[mode] only affect VITE_* variables.

# --- Server ---------------------------------------------------------------
# API / production server port (the Vite dev server proxies /api here).
PORT=8787
# Bind address (default: 127.0.0.1 in development, all interfaces with `npm start` / --production /
# NODE_ENV=production). Setting it (e.g. 0.0.0.0) in development exposes the dev API, and its API keys, to your network.
# HOST=0.0.0.0
# Production only: directory with the built SPA (default ./dist).
# STATIC_DIR=./dist
# '1' behind exactly one reverse proxy: rate-limit by the last X-Forwarded-For hop ('ip:port' hops are fine).
# TRUST_PROXY=1
# '1' to send COOP + COEP: credentialless so onnxruntime-web can use multi-threaded WASM
# (faster CPU inference for the ML drivers). Also honoured by `vite` / `vite preview`.
# CROSS_ORIGIN_ISOLATION=1

# --- Tripo3D cloud driver --------------------------------------------------
# Server-side key (https://platform.tripo3d.ai). Empty = users enter their own key in the UI.
TRIPO_API_KEY=
# Tripo OpenAPI base URL.
# TRIPO_API_BASE=https://api.tripo3d.ai/v2/openapi
# Comma-separated hosts (and subdomains) model files may be downloaded from.
# TRIPO_ALLOWED_MODEL_HOSTS=tripo3d.ai,tripo3d.com,tripo-data.cdn.bcebos.com
# Task creations per client IP and window: with the server key / with the user's own key (0 = unlimited).
# TRIPO_RATE_LIMIT=10
# TRIPO_RATE_LIMIT_BYOK=60
# TRIPO_RATE_WINDOW_SEC=3600
# Task status polls + model downloads per client IP and minute (each is a Tripo API call; 0 = unlimited).
# TRIPO_READ_RATE_LIMIT=300
# Uploads received at once over all clients (each is buffered in memory; 0 = no cap). Each client IP
# may have at most 3 in progress regardless. Too low lets a few slow uploaders hold up everyone else.
# TRIPO_MAX_CONCURRENT_UPLOADS=16

# Order of the four views in Tripo's multi-view task (POST /api/tripo/multiview-tasks). Change only if
# Tripo's API expects another order than the assumed one.
# TRIPO_MULTIVIEW_ORDER=front,left,back,right

# --- AI providers (image edit / background removal / image → 3D) ----------------
# Server-side keys. Each one set shows up as a "managed" provider in the AI Providers dialog
# (GET /api/ai/providers) and is injected by the proxy (/api/ai/proxy/<kind>/…); the key never
# reaches the browser. Leave empty to let users enter their own keys instead.
# Every request made with these keys is billed to you: keep the rate limits below sensible.
OPENAI_API_KEY=
# Model the managed OpenAI provider uses for image edits (default: the app's suggestion, e.g. gpt-image-1).
# OPENAI_IMAGE_MODEL=gpt-image-1
GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
STABILITY_API_KEY=
REPLICATE_API_TOKEN=
FAL_KEY=
# (TRIPO_API_KEY above also enables a managed Tripo3D provider.)

# Proxy (/api/ai/proxy/<kind>/<path>): forwards to the kind's fixed API host only
# (openai → api.openai.com, gemini → generativelanguage.googleapis.com, stability → api.stability.ai,
# replicate → api.replicate.com, fal → fal.run / queue.fal.run, tripo → api.tripo3d.ai).
# Kinds the proxy serves (default: all of the above).
# AI_PROXY_KINDS=openai,gemini,stability,replicate,fal,tripo
# '0' = do not relay users' own keys (x-ai-key header); only the server keys above are used. Default 1.
# AI_PROXY_BYOK=1
# 'openai-compatible' / 'custom-http' providers are browser-direct only, unless their base URL is listed
# here (comma-separated, exact match incl. path; http allowed for e.g. a local server). The client names
# the base in the x-ai-base header; anything else is refused, so the proxy never talks to other hosts.
# AI_PROXY_EXTRA_BASES=https://api.together.xyz/v1,http://127.0.0.1:11434/v1
# Seconds to wait for an upstream answer (response headers; image edits can take minutes). Default 180.
# AI_PROXY_TIMEOUT_SEC=180
# Largest request body forwarded, in MB. Default 40.
# AI_PROXY_MAX_BODY_MB=40
# Generation requests (POST/PUT/PATCH/DELETE) per client IP and window: with a server key / with the
# user's own key (0 = unlimited). One AI-prepared model can take ~10 (restyle, 5 views, background removal, 3D).
# AI_PROXY_RATE_LIMIT=60
# AI_PROXY_RATE_LIMIT_BYOK=600
# AI_PROXY_RATE_WINDOW_SEC=3600
# Status polls (GET) + output downloads per client IP and minute (0 = unlimited).
# AI_PROXY_READ_RATE_LIMIT=300
# Proxied requests in progress over all clients (0 = no cap); each client IP may have at most 8.
# AI_PROXY_MAX_CONCURRENT=64

# Output downloads (/api/ai/fetch?url=…, for generated files whose host blocks CORS): https hosts
# allowed, comma-separated. 'host' = the host and its subdomains, '*.host' = subdomains only,
# 'host/path' = only under that path. Replaces the default list, which is
# replicate.delivery,fal.media,storage.googleapis.com/falserverless plus TRIPO_ALLOWED_MODEL_HOSTS.
# IP addresses, other ports, credentials and redirects to other hosts are always refused.
# AI_FETCH_ALLOWED_HOSTS=replicate.delivery,fal.media,storage.googleapis.com/falserverless,tripo3d.ai,tripo3d.com,tripo-data.cdn.bcebos.com
# Largest downloaded file (and largest proxied response), in MB. Default 200.
# AI_FETCH_MAX_MB=200

# --- Browser build (Vite, read at build/dev time) ---------------------------
# Mirror for Hugging Face model files (default https://huggingface.co/).
# VITE_MODEL_HOST=https://huggingface.co/
# Other directory for the onnxruntime-web wasm (default: the copy bundled into /assets). Serve the
# ort-wasm-simd-threaded*.{mjs,wasm} files from node_modules/onnxruntime-web/dist/ there.
# VITE_ORT_WASM_PREFIX=/ort/
# Optional source-code link shown in the top bar.
# VITE_REPO_URL=https://github.com/you/3dmarker

# Human detail (MediaPipe face / hand / pose landmarks, loaded on first use):
# where the .task models live (default Google's public bucket). A relative value (e.g. 'mediapipe/')
# resolves against the page, so self-hosted copies also work under a GitHub Pages sub-path.
# VITE_MEDIAPIPE_MODEL_BASE=https://storage.googleapis.com/mediapipe-models/
# Serve the MediaPipe wasm runtime from this directory instead of the copy bundled into /assets.
# VITE_MEDIAPIPE_WASM_BASE=/mediapipe-wasm/
# Pose model: lite (~5.5 MB) | full (default, ~9 MB) | heavy (~29 MB). A missing model falls back towards lite.
# VITE_MEDIAPIPE_POSE_MODEL=full
# auto (GPU, CPU when WebGL2 is missing or software-rendered; default) | GPU | CPU
# VITE_MEDIAPIPE_DELEGATE=auto
